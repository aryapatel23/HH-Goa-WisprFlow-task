generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  student
  manager
  admin
}

enum MealSlot {
  breakfast
  lunch
  snacks
  dinner
}

enum ComplaintCategory {
  HYGIENE
  TASTE
  QUANTITY
  SERVICE
  OTHER
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        Role      @default(student)
  hostelBlock String?
  roomNumber  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  ratings     Rating[]
  skips       Skip[]
  streak      Streak?
}

model Meal {
  id         String     @id @default(cuid())
  date       DateTime
  slot       MealSlot
  startTime  String
  endTime    String
  cutoffTime DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  dishes     Dish[]
  ratings    Rating[]
  skips      Skip[]
  complaints Complaint[]

  @@unique([date, slot])
}

model Dish {
  id         String      @id @default(cuid())
  name       String
  category   String?
  mealId     String
  meal       Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  ratings    Rating[]
  complaints Complaint[]

  @@index([mealId])
}

model Rating {
  id        String   @id @default(cuid())
  star      Int      // 1 to 5 stars
  reaction  String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  dishId    String?
  dish      Dish?    @relation(fields: [dishId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([mealId])
  @@index([dishId])
  @@index([userId])
}

model Skip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, mealId])
  @@index([mealId])
  @@index([userId])
}

// Anonymous complaint box: Strictly NO userId is stored
model Complaint {
  id         String            @id @default(cuid())
  text       String
  language   String            @default("en") // en, hi, gu, hinglish
  category   ComplaintCategory @default(OTHER)
  sentiment  Sentiment         @default(NEGATIVE)
  urgency    UrgencyLevel      @default(MEDIUM)
  linkDetail String?           // contextual link detail / dish details / location
  audioUrl   String?
  mealId     String?
  meal       Meal?             @relation(fields: [mealId], references: [id], onDelete: SetNull)
  dishId     String?
  dish       Dish?             @relation(fields: [dishId], references: [id], onDelete: SetNull)
  resolved   Boolean           @default(false)
  createdAt  DateTime          @default(now())

  @@index([category])
  @@index([urgency])
  @@index([mealId])
  @@index([dishId])
}

// Waste-Free Streak model
model Streak {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastSkipDate  DateTime?
  lastPlateDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}


// AI-Generated Weekly Report model
model WeeklyReport {
  id          String   @id @default(cuid())
  weekStart   DateTime
  content     String   // AI-generated markdown summary
  metricsJson Json     // aggregated statistics
  createdAt   DateTime @default(now())
}
