// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  MANAGER
  ADMIN
}

enum MealSlot {
  BREAKFAST
  LUNCH
  SNACKS
  DINNER
}

enum ComplaintCategory {
  HYGIENE
  TASTE
  QUANTITY
  SERVICE
  OTHER
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Sentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String?
  role        Role       @default(STUDENT)
  hostelBlock String?
  roomNumber  String?
  streakCount Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  ratings     Rating[]
  mealSkips   MealSkip[]
}

model Meal {
  id          String     @id @default(cuid())
  date        DateTime
  slot        MealSlot
  startTime   String
  endTime     String
  cutoffTime  DateTime
  dishes      Dish[]
  ratings     Rating[]
  mealSkips   MealSkip[]
  complaints  Complaint[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([date, slot])
}

model Dish {
  id          String      @id @default(cuid())
  name        String
  category    String?     // e.g. Main Course, Dal, Bread, Dessert
  mealId      String
  meal        Meal        @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ratings     Rating[]
  complaints  Complaint[]
  createdAt   DateTime    @default(now())
}

model Rating {
  id        String   @id @default(cuid())
  stars     Int      // 1-5
  reaction  String?  // emoji or quick note
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  dishId    String?
  dish      Dish?    @relation(fields: [dishId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([mealId])
  @@index([dishId])
}

model MealSkip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([userId, mealId])
}

// Anonymous complaint box: identity is never stored with it
model Complaint {
  id          String            @id @default(cuid())
  text        String
  audioUrl    String?
  language    String?           @default("en") // en, hi, gu, hinglish
  category    ComplaintCategory @default(OTHER)
  sentiment   Sentiment         @default(NEGATIVE)
  urgency     UrgencyLevel      @default(MEDIUM)
  mealId      String?
  meal        Meal?             @relation(fields: [mealId], references: [id], onDelete: SetNull)
  dishId      String?
  dish        Dish?             @relation(fields: [dishId], references: [id], onDelete: SetNull)
  resolved    Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([category])
  @@index([urgency])
}

model WeeklyReport {
  id          String   @id @default(cuid())
  weekStart   DateTime
  content     String   // AI-generated summary
  metricsJson Json     // aggregated statistics
  createdAt   DateTime @default(now())
}
