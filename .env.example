# Database Connection (PostgreSQL - Neon / Supabase / Local)
# DATABASE_URL: Pooled connection string (e.g., port 6543 / PgBouncer)
DATABASE_URL="postgresql://postgres:password@localhost:5432/messmeter?schema=public"
# DIRECT_URL: Direct unpooled connection string for migrations (e.g., port 5432)
DIRECT_URL="postgresql://postgres:password@localhost:5432/messmeter?schema=public"

# Vercel Deployment Migration Flag (set to "true" to run prisma migrate deploy during build)
MIGRATE_DEPLOY_BEFORE_NEXT_JS_BUILD="false"

# AI API Configuration (GroqCloud / xAI OpenAI-compatible SDK)
XAI_BASE_URL="https://api.groq.com/openai/v1"
XAI_API_KEY="gsk_your_groq_key_or_xai_key"
GROQ_API_KEY="gsk_your_groq_key"
GROQ_MODEL="openai/gpt-oss-120b"

# NextAuth / Auth.js Secret for session encryption
AUTH_SECRET="your-random-32-character-secret-string-here"
NEXTAUTH_SECRET="your-random-32-character-secret-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Provider (Optional)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# App Configurations
NEXT_PUBLIC_APP_NAME="MassMatter"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
