# Database Connection (PostgreSQL - Neon / Supabase / Local)
DATABASE_URL="postgresql://postgres:password@localhost:5432/messmeter?schema=public"

# Anthropic Claude API Key for AI Analysis & Voice Intelligence
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-api-key-here"

# NextAuth / Auth.js Secret for session encryption
AUTH_SECRET="your-random-32-character-secret-string-here"
NEXTAUTH_SECRET="your-random-32-character-secret-string-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth Provider (Optional)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional App Configurations
NEXT_PUBLIC_APP_NAME="MassMatter"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
